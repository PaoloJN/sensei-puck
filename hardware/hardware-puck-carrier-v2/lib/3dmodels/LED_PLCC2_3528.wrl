#VRML V2.0 utf8
# Generic PLCC-2 3528 SMD LED, 3.5 x 2.8 x ~1.9 mm — simplified cosmetic model
# White body + translucent lens hint. Shared by D1-D3 (white / 850 nm / 365 nm).
# Centered on footprint origin (stock LED_Everlight-SMD3528 outline: X +-1.75, Y +-1.4).
# Scale: 1 VRML unit = 2.54 mm (KiCad convention).

# --- white package body ---
Transform {
  translation 0 0 0.31496
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.93 0.93 0.90
          specularColor 0.30 0.30 0.30
          shininess 0.30
        }
      }
      geometry Box { size 1.37795 1.10236 0.62992 }
    }
  ]
}

# --- translucent lens (flat dome hint), axis rotated to +Z ---
Transform {
  translation 0 0 0.64961
  rotation 1 0 0 1.5708
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.95 0.92 0.75
          specularColor 0.80 0.80 0.80
          shininess 0.80
          transparency 0.35
        }
      }
      geometry Cylinder { radius 0.43307 height 0.19685 }
    }
  ]
}
