#VRML V2.0 utf8
# E73-2G4M08S1C (EBYTE nRF52840 module) — simplified cosmetic model
# Hand-authored: 18.16 x 13.21 x 0.8 mm PCB base + RF shield can + ceramic
# antenna block at the +X (pad-free) end. Matches puck:E73-2G4M08S1C footprint
# origin (body X -0.127..18.034, Y +-6.604, KiCad units).
# Scale: 1 VRML unit = 2.54 mm (KiCad convention).

# --- module PCB (green) ---
Transform {
  translation 3.52500 0 0.15748
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.05 0.30 0.12
          specularColor 0.10 0.10 0.10
          shininess 0.25
        }
      }
      geometry Box { size 7.15000 5.20000 0.31496 }
    }
  ]
}

# --- RF shield can (covers ~70%, antenna end left bare) ---
Transform {
  translation 2.61811 0 0.55118
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.72 0.75 0.78
          specularColor 0.90 0.90 0.90
          shininess 0.60
        }
      }
      geometry Box { size 4.92126 4.88189 0.47244 }
    }
  ]
}

# --- ceramic chip antenna at the bare +X end ---
Transform {
  translation 6.10236 0 0.49213
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.85 0.80 0.70
          specularColor 0.20 0.20 0.20
          shininess 0.20
        }
      }
      geometry Box { size 1.96850 0.62992 0.35433 }
    }
  ]
}
